{
  "mcpServers": {
    "curl-mcp": {
      "command": "npx",
      "args": [
        "@247arjun/mcp-curl"
      ],
      "disabled": false,
      "autoApprove": [
        "curl_get",
        "curl_post"
      ]
    },
    "cipher": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "disabled": false,
      "autoApprove": [
        "write_file"
      ]
    }
  }
}